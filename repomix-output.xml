  animation-delay: -3s;
}
.ph-orb-3 {
  width: 200px; height: 200px;
  top: 40%; left: 45%;
  background: radial-gradient(circle, rgba(0,212,255,0.12), transparent 70%);
  animation: glowPulseCyan 5s ease-in-out infinite;
}
.ph-inner {
