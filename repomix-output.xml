  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--color-accent), var(--color-cyan));
  opacity: 0;
  transition: opacity var(--transition-base);
}
.service-detail-feature-item:hover {
  transform: translateY(-6px);
  box-shadow: 0 20px 48px rgba(12,28,66,0.14);
  border-color: rgba(31,140,255,0.20);
}
.service-detail-feature-item:hover::after { opacity: 1; }
.service-detail-feature-icon {
  width: 68px;
  height: 68px;
  background: linear-gradient(135deg, rgba(31,140,255,0.10), rgba(0,212,255,0.08));
  border: 1px solid rgba(31,140,255,0.18);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16px;
  font-size: 26px;
  color: var(--color-accent);
  box-shadow: 0 0 20px var(--glow-blue-soft);
}
.service-detail-feature-item strong {
  display: block;
  color: var(--color-primary-mid);
  font-size: 1rem;
  margin-bottom: 8px;
}
.service-detail-feature-copy {
  margin-top: 6px;
  color: var(--text-muted);
  font-size: 0.875rem;
  line-height: 1.7;
}

/* ─── STATS CARDS (About page) ─── */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  position: relative; z-index: 1;
}
.stats-card {
  background: white;
  border-radius: var(--radius-lg);
  padding: 32px 24px;
  text-align: center;
  box-shadow: 0 16px 40px rgba(12,28,66,0.09);
  border: 1px solid rgba(24,47,104,0.07);
  transition: all var(--transition-base);
  position: relative;
  overflow: hidden;
}
.stats-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--color-accent), var(--color-cyan));
  opacity: 0;
  transition: opacity var(--transition-base);
}
.stats-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 28px 60px rgba(12,28,66,0.16);
  border-color: rgba(31,140,255,0.20);
}
.stats-card:hover::before { opacity: 1; }
.stats-value {
  font-size: 2.8rem;
  font-weight: 800;
  font-family: var(--font-display);
  background: linear-gradient(135deg, var(--color-accent), var(--color-cyan));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1;
  margin-bottom: 10px;
}
.stats-card strong {
  display: block;
  font-size: 1rem;
  color: var(--color-primary-mid);
  margin-bottom: 6px;
}
.stats-card p {
  font-size: 0.875rem;
  color: var(--text-muted);
}

/* ─── VALUE / FAQ CARDS ─── */
.value-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  position: relative; z-index: 1;
}
.value-card {
  background: white;
  border-radius: var(--radius-lg);
  padding: 28px;
  box-shadow: 0 12px 32px rgba(12,28,66,0.08);
  border: 1px solid rgba(24,47,104,0.07);
  transition: all var(--transition-base);
  position: relative;
  overflow: hidden;
}
.value-card::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 3px;
  background: linear-gradient(to bottom, var(--color-accent), var(--color-cyan));
  opacity: 0;
  transition: opacity var(--transition-base);
}
.value-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 20px 48px rgba(12,28,66,0.13);
  border-color: rgba(31,140,255,0.18);
}
.value-card:hover::before { opacity: 1; }
.value-card h3 {
  font-size: 1rem;
  font-weight: 700;
  color: var(--color-primary-mid);
  margin-bottom: 10px;
}
.value-card p {
  font-size: 0.9rem;
  color: var(--text-muted);
  line-height: 1.7;
}

/* ─── CONTACT SECTION 3D ─── */
.contact-section {
  padding: var(--section-padding);
  background:
    radial-gradient(circle at 80% 20%, rgba(31,140,255,0.06), transparent 40%),
    radial-gradient(circle at 10% 80%, rgba(0,212,255,0.04), transparent 40%),
    linear-gradient(180deg, #f0f4ff 0%, #eef2ff 100%);
  position: relative;
  overflow: hidden;
}
.contact-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle, rgba(31,140,255,0.06) 1px, transparent 1px);
  background-size: 32px 32px;
  pointer-events: none;
}
.contact-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: start;
  position: relative; z-index: 1;
}
.contact-items { margin-top: 36px; display: flex; flex-direction: column; gap: 20px; }
.contact-item { display: flex; align-items: flex-start; gap: 16px; }
.contact-icon {
  width: 48px; height: 48px;
  background: linear-gradient(135deg, var(--color-accent-dark), var(--color-accent));
  color: white;
  border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 0 20px var(--glow-blue-soft);
}
.contact-item strong { display: block; font-size: 0.9rem; color: var(--color-primary-mid); }
.contact-item span   { font-size: 0.875rem; color: var(--text-muted); }
.contact-phone-list {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.contact-phone-list a {
  color: var(--color-accent);
  font-weight: 600;
}
.contact-form-wrapper {
  background: white;
  border-radius: var(--radius-xl);
  padding: 40px;
  box-shadow: 0 24px 60px rgba(12,28,66,0.12);
  border: 1px solid rgba(24,47,104,0.08);
  position: relative;
  overflow: hidden;
}
/* Neon top edge on form */
.contact-form-wrapper::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--color-accent), var(--color-cyan));
}
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.form-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 20px; }
.form-group label { font-size: 13px; font-weight: 700; color: var(--color-primary-mid); }
.form-group input,
.form-group textarea,
.form-group select {
  width: 100%;
  padding: 13px 16px;
  border: 1.5px solid rgba(24,47,104,0.14);
  border-radius: var(--radius-md);
  font-family: var(--font-family);
  font-size: 14px; color: var(--text-dark);
  transition: border-color var(--transition-base), box-shadow var(--transition-base);
  outline: none; resize: none;
  background: #fafbff;
}
.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 3px var(--glow-blue-soft);
  background: white;
}
.form-message {
  padding: 12px 16px; border-radius: var(--radius-md);
  font-size: 14px; margin-top: 12px; font-weight: 600;
}
.form-message.success { background: rgba(5,150,105,0.08); color: #065f46; border: 1px solid rgba(5,150,105,0.2); }
.form-message.error   { background: rgba(220,38,38,0.08); color: #991b1b; border: 1px solid rgba(220,38,38,0.2); }
.contact-submit-btn { width: 100%; justify-content: center; }

.service-packages-section {
  padding: var(--section-padding);
  background: linear-gradient(180deg, #f2f6ff 0%, #ffffff 100%);
}
.service-packages-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
}
.service-package-card {
  position: relative;
  height: 100%;
  min-width: 0;
  border-radius: var(--radius-xl);
  padding: 28px;
  border: 1px solid rgba(19, 44, 102, 0.1);
  background: #ffffff;
  box-shadow: var(--shadow-sm);
}
.service-package-card.featured {
  border-color: rgba(31, 140, 255, 0.4);
  box-shadow: 0 18px 50px rgba(23, 87, 185, 0.2);
}
.service-package-badge {
  position: absolute;
  top: -12px;
  left: 20px;
  display: inline-flex;
  align-items: center;
  padding: 6px 10px;
  border-radius: var(--radius-full);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.03em;
  color: #fff;
  background: var(--color-accent);
}
.service-package-card h3 {
  font-family: var(--font-display);
  color: var(--color-primary);
  font-size: 1.4rem;
  margin-bottom: 8px;
}
.service-package-price {
  color: var(--color-primary);
  font-size: 1.5rem;
  font-weight: 800;
  margin-bottom: 6px;
}
.service-package-currency-note {
  margin-bottom: 8px;
  font-size: 12px;
  font-weight: 700;
  color: var(--text-muted);
}
.service-package-timeline {
  color: var(--color-accent);
  font-size: 13px;
  font-weight: 700;
  margin-bottom: 14px;
}
.service-package-summary {
  color: var(--text-muted);
  font-size: 0.92rem;
  line-height: 1.7;
  margin-bottom: 14px;
}
.service-package-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 22px;
}
.service-package-list li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  color: var(--text-medium);
  font-size: 0.9rem;
}
.service-package-list i {
  color: var(--color-accent);
  margin-top: 2px;
}
.service-package-contact-note {
  margin: 0 0 14px;
  padding: 10px 12px;
  border-radius: var(--radius-md);
  border: 1px solid rgba(31, 140, 255, 0.22);
  background: rgba(31, 140, 255, 0.06);
  color: var(--color-primary);
  font-size: 0.84rem;
  line-height: 1.6;
  font-weight: 600;
}
.service-package-cta {
  width: 100%;
  justify-content: center;
}

/* ─── PAGE SHELLS / CONTENT ─── */
.page-shell {
  padding-top: 70px;
}

.page-content-narrow {
  max-width: 800px;
  margin: 0 auto;
  padding: 60px 5%;
}

.page-center {
  text-align: center;
}

.page-subtitle-center {
  margin: 0 auto 16px;
  max-width: 720px;
}

.page-section-gap {
  margin-top: 40px;
}

.page-section-white,
.page-section-muted {
  padding: var(--section-padding);
}

.page-section-white {
  background: white;
}

.page-section-muted {
  background: var(--bg-light);
}

.page-form-container {
  max-width: 700px;
}

.quote-submit-btn {
  width: 100%;
  justify-content: center;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.stats-card {
  background: white;
  border-radius: var(--radius-lg);
  padding: 28px 24px;
  text-align: center;
  box-shadow: var(--shadow-md);
  border: 1px solid rgba(0, 0, 0, 0.05);
}

.value-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.value-card {
  background: white;
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: var(--shadow-sm);
  border: 1px solid rgba(0, 0, 0, 0.05);
}

.blog-grid .blog-card-title,
.blog-post-shell .section-title {
  word-break: break-word;
}

.blog-card-title {
  font-size: 1.3rem;
  line-height: 1.25;
  margin-bottom: 12px;
}

.blog-card-excerpt {
  font-size: 0.95rem;
  line-height: 1.75;
  color: var(--text-muted);
}

.blog-post-shell {
  max-width: 800px;
  margin: 0 auto;
  padding: 60px 5%;
}

.blog-back-link {
  margin-bottom: 24px;
  display: inline-flex;
}

.blog-category-static {
  position: static;
  display: inline-block;
  margin-bottom: 16px;
}

.blog-post-meta {
  margin: 16px 0 32px;
  flex-wrap: wrap;
}

.blog-post-image-wrap {
  position: relative;
  height: 400px;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 40px;
  background: linear-gradient(135deg, rgba(69, 56, 94, 0.08), rgba(74, 154, 243, 0.12));
}

.blog-post-image {
  object-fit: cover;
}

.contact-map-placeholder {
  min-height: 280px;
  background: var(--bg-light);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32px 5%;
}

.contact-map-message {
  text-align: center;
  color: var(--text-muted);
}

.contact-map-icon {
  display: block;
  font-size: 48px;
  margin-bottom: 16px;
  color: var(--color-accent);
}

.enquiries-section .container {
  display: grid;
  gap: 24px;
}

.enquiries-card {
  background: white;
  border-radius: var(--radius-xl);
  border: 1px solid rgba(19, 44, 102, 0.1);
  box-shadow: var(--shadow-sm);
  padding: 22px;
}

.enquiries-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 16px;
}

.enquiries-card-head h2 {
  color: var(--color-primary);
  font-size: 1.15rem;
}

.enquiries-card-head span {
  display: inline-flex;
  align-items: center;
  padding: 6px 10px;
  border-radius: var(--radius-full);
  background: rgba(31, 140, 255, 0.08);
  color: var(--color-primary);
  font-size: 12px;
  font-weight: 700;
}

.enquiries-table-wrap {
  overflow-x: auto;
}

.enquiries-table {
  width: 100%;
  border-collapse: collapse;
  min-width: 720px;
}

.enquiries-table th,
.enquiries-table td {
  text-align: left;
  padding: 12px 10px;
  border-bottom: 1px solid rgba(15, 35, 87, 0.08);
  vertical-align: top;
  font-size: 0.88rem;
}

.enquiries-table th {
  color: var(--color-primary);
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.enquiries-message-cell {
  max-width: 420px;
  white-space: pre-wrap;
}

.enquiries-empty {
  color: var(--text-muted);
  font-size: 0.92rem;
}

.enquiries-error {
  margin: 0;
  padding: 12px 14px;
  border-radius: var(--radius-md);
  border: 1px solid rgba(220, 38, 38, 0.24);
  background: rgba(254, 226, 226, 0.6);
  color: #7f1d1d;
  font-size: 0.9rem;
  font-weight: 600;
}

.not-found-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 40px 5%;
  background: linear-gradient(135deg, #0d1b4b, #1a1f5e);
}

.not-found-code {
  font-size: clamp(5rem, 16vw, 8rem);
  font-weight: 800;
  color: #f5a623;
  line-height: 1;
}

.not-found-title {
  font-size: clamp(1.6rem, 4vw, 2rem);
  color: white;
  margin: 16px 0;
}

.not-found-text {
  color: rgba(255, 255, 255, 0.7);
  max-width: 400px;
  margin-bottom: 40px;
}

/* ═══════════════════════════════════
   RESPONSIVE
═══════════════════════════════════ */
@media (max-width: 1024px) {
  /* Keep the dark glassmorphism navbar — do NOT override to white */
  .hero-visual-chip,
  .hero-visual-card,
  .hero-stats-card,
  .hero-feature-card,
  .dropdown-menu {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .hero-visual-glow {
    display: none;
  }

  #tsparticles {
    display: none;
  }

  .services-grid     { grid-template-columns: repeat(2, 1fr); }
  .industries-grid   { grid-template-columns: repeat(4, 1fr); }
  .testimonials-grid { grid-template-columns: repeat(2, 1fr); }
  .footer-grid       { grid-template-columns: repeat(2, 1fr); }
  .process-inner     { grid-template-columns: 1fr; gap: 48px; }
  .blog-grid         { grid-template-columns: repeat(2, 1fr); }
  .service-detail-feature-grid { grid-template-columns: repeat(2, 1fr); }
  .service-packages-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 768px) {
  :root {
    --section-padding: 56px 5%;
    --section-padding-sm: 42px 5%;
    --card-padding: 24px;
  }

  .container {
    padding: 0 5%;
  }

  .section-title {
    font-size: 2rem;
  }

  .section-subtitle {
    max-width: 100%;
    font-size: 0.96rem;
    line-height: 1.65;
  }

  .btn {
    min-height: 46px;
    padding: 14px 24px;
    font-size: 1rem;
  }

  .hamburger { display: flex; }
  .nav-menu {
    position: fixed; top: 64px; left: 0;
    width: 100%;
    height: auto;
    max-height: calc(100vh - 76px);
    background:
      radial-gradient(circle at 85% 8%, rgba(0,212,255,0.18), transparent 32%),
      radial-gradient(circle at 8% 92%, rgba(124,58,237,0.14), transparent 34%),
      linear-gradient(180deg, #060d20 0%, #0c1a3e 100%);
    flex-direction: column;
    padding: 20px 5% 26px;
    gap: 10px;
    transform: translateX(-100%);
    transition: transform 0.35s ease;
    overflow-y: auto;
    z-index: 999;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    box-shadow: 0 16px 36px rgba(0,0,0,0.5);
  }
  .nav-menu.open   { transform: translateX(0); }
  .nav-item {
    width: 100%;
    animation: none;
  }
  .nav-item:nth-child(2) { animation-delay: 0.04s; }
  .nav-item:nth-child(3) { animation-delay: 0.08s; }
  .nav-item:nth-child(4) { animation-delay: 0.12s; }
  .nav-item:nth-child(5) { animation-delay: 0.16s; }
  .nav-item:nth-child(6) { animation-delay: 0.2s; }
  .nav-link,
  .dropdown-toggle {
    display: flex;
    align-items: center;
    width: 100%;
    text-align: left;
    justify-content: space-between;
    padding: 14px 14px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,0.10);
    background: rgba(255,255,255,0.06);
    box-shadow: 0 4px 16px rgba(0,0,0,0.3);
    font-weight: 600;
    color: white;
    min-height: 46px;
  }
  .nav-link.active {
    color: white;
    background: linear-gradient(135deg, rgba(12,26,62,0.9) 0%, rgba(31,140,255,0.35) 100%);
    border-color: rgba(0,212,255,0.35);
    box-shadow: 0 0 20px var(--glow-blue-soft);
  }
  .nav-link.active::after {
    display: none;
  }
  .dropdown-toggle i {
    transition: transform 0.25s ease;
  }
  .dropdown-toggle.open i {
    transform: rotate(180deg);
  }
  .navbar-actions { display: none; }
  .navbar-container { height: 64px; gap: 12px; }
  .logo-text { font-size: 19px; }
  .text-logo { gap: 8px; min-width: 0; }
  .brand-lockup {
    min-width: 0;
    transform: translateY(0);
    overflow: visible;
  }
  .brand-logo-image {
    width: 34px;
    height: 34px;
  }
  .brand-name {
    font-size: 1.08rem;
    line-height: 1.05;
  }
  .brand-subtitle {
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.55);
  }
  /* Mobile dropdown — dark theme to match the dark mobile menu */
  .dropdown-menu {
    position: static;
    transform: none;
    min-width: 0;
    width: 100%;
    max-width: 100%;
    box-shadow: none;
    border: 1px solid rgba(0, 212, 255, 0.18);
    background: rgba(6, 13, 32, 0.85);
    border-radius: 12px;
    backdrop-filter: blur(8px);
    grid-template-columns: 1fr;
    margin-top: 8px;
    padding: 8px;
  }
  .dropdown-menu a {
    border-radius: 10px;
    padding: 11px 12px;
    font-size: 13px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.85);
    min-height: 44px;
  }
  .dropdown-menu a:hover {
    background: rgba(0, 212, 255, 0.12);
    color: var(--color-cyan);
  }
  .dropdown-menu a i {
    color: var(--color-accent-light);
  }
  .dropdown-menu.open { transform: none; }
  .hero-section    { min-height: auto; padding-top: 64px; }
  .hero-content    { grid-template-columns: 1fr; text-align: center; gap: 20px; padding: 20px 5% 26px; }
  .hero-left,
  .hero-right      { width: 100%; }
  .hero-right      { order: 2; }
  .hero-left       { order: 1; }

  /* 3D Scene optimization for tablet */
  .scene3d-outer {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }
  .scene3d-perspective {
    perspective: 900px;
    perspective-origin: 50% 40%;
    width: 100%;
    height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .scene3d-stage {
    position: relative;
    width: 200px;
    height: 200px;
    transform-style: preserve-3d;
    transform: rotateX(var(--scene-rx, -4deg)) rotateY(var(--scene-ry, -8deg));
    transition: transform 0.12s ease-out;
    will-change: transform;
  }
  .scene3d-metrics {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .scene3d-chip-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .hero-subtitle   { font-size: 1rem; }
  .hero-description { font-size: 0.95rem; margin: 0 auto 18px; }
  .hero-trust-strip { justify-content: center; }
  .hero-visual-main { padding: 22px; text-align: left; }
  .hero-visual-main h3 { font-size: 1.2rem; }
  .hero-visual-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .hero-visual-mini { padding: 16px; text-align: left; }
  .hero-buttons { margin-bottom: 16px; }
  .hero-cta { width: 100%; justify-content: center; }
  .hero-stats-card {
    flex-direction: column;
    align-items: stretch;
    gap: 14px;
    padding: 18px;
  }
  .hero-stats-card .stats-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-align: left;
  }
  .stats-label { margin-top: 0; }
  .hero-features { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .hero-feature-card { padding: 20px 14px; }
  .hero-feature-card h3 { font-size: 14px; }
  .hero-feature-card p { font-size: 12px; }
  .services-grid   { grid-template-columns: 1fr; }
  .industries-grid { grid-template-columns: repeat(3, 1fr); }
  .testimonials-grid { grid-template-columns: 1fr; }
  .featured-work-grid { grid-template-columns: 1fr; }
  .blog-grid       { grid-template-columns: 1fr; }
  .service-detail-feature-grid { grid-template-columns: 1fr; }
  .service-packages-grid { grid-template-columns: 1fr; }
  .service-package-card { padding: 20px; }
  .service-package-cta,
  .process-cta-btn,
  .footer-cta-link {
    width: 100%;
    justify-content: center;
  }
  .plans-proof-strip {
    justify-content: flex-start;
  }
  .plans-proof-strip span {
    width: 100%;
    justify-content: center;
    min-height: 44px;
  }
  .process-cta-btn {
    margin-top: 20px;
  }
  .process-inner {
    gap: 32px;
  }
  .process-step {
    padding-bottom: 24px;
    gap: 14px;
  }
  .step-content p {
    font-size: 0.9rem;
  }
  .page-content-narrow,
  .blog-post-shell {
    padding: 44px 5%;
  }
  .stats-grid,
  .value-grid {
    grid-template-columns: 1fr;
  }
  .stats-card,
  .value-card {
    padding: 22px;
  }
  .blog-card-title {
    font-size: 1.15rem;
  }
  .blog-post-image-wrap {
    height: 260px;
    margin-bottom: 28px;
  }
  .blog-post-meta {
    margin: 14px 0 24px;
  }
  .page-form-container {
    max-width: 100%;
  }
  .contact-map-placeholder {
    min-height: 220px;
  }
  .enquiries-card {
    padding: 16px;
  }
  .enquiries-card-head {
    align-items: flex-start;
    flex-direction: column;
  }
  .contact-inner   { grid-template-columns: 1fr; }
  .form-row        { grid-template-columns: 1fr; }
  .contact-form-wrapper {
    padding: 20px;
    width: 100%;
  }
  .contact-section .section-header,
  .services-section .section-header,
  .featured-work-section .section-header,
  .process-section .section-header,
  .industries-section .section-header,
  .testimonials-section .section-header,
  .blog-section .section-header {
    margin-bottom: 40px;
  }
  .blog-tabs { justify-content: flex-start; overflow-x: auto; flex-wrap: nowrap; padding-bottom: 8px; }
  .blog-tab {
    min-height: 44px;
    font-size: 0.95rem;
    padding: 10px 18px;
    white-space: nowrap;
  }
  .blog-card-meta {
    flex-wrap: wrap;
    row-gap: 6px;
  }
  .cta-buttons { flex-direction: column; align-items: stretch; }
  .cta-buttons .btn {
    width: 100%;
    justify-content: center;
    min-height: 48px;
    font-size: 1rem;
  }
  .cta-banner-section p {
    margin: 0 auto 26px;
    font-size: 1rem;
  }
  .footer-grid     { grid-template-columns: 1fr; gap: 32px; }
  .footer {
    padding-top: 56px;
  }
  .footer-bottom   { flex-direction: column; gap: 12px; text-align: center; }
  .footer-bottom-links {
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 16px;
  }

  @keyframes navItemReveal {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }

  #tsparticles {
    display: none !important;
  }
}

@media (max-width: 480px) {
  :root {
    --section-padding: 44px 5%;
    --section-padding-sm: 32px 5%;
    --card-padding: 20px;
  }

  .section-title   { font-size: 1.62rem; }
  .section-header { margin-bottom: 28px; }
  .industries-grid { grid-template-columns: repeat(2, 1fr); }
  .hero-title      { font-size: 1.8rem; }

  /* 3D Scene optimization for small mobile */
  .scene3d-perspective {
    height: 240px;
  }
  .scene3d-stage {
    width: 160px;
    height: 160px;
  }
  .scene3d-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    transform-style: preserve-3d;
  }
  .scene3d-ring-1 {
    border: 1.5px solid rgba(31,140,255,0.55);
    box-shadow: 0 0 15px rgba(31,140,255,0.4);
  }
  .scene3d-ring-2 {
    inset: -30px;
    border: 1px solid rgba(0,212,255,0.40);
    box-shadow: 0 0 18px rgba(0,212,255,0.3);
  }
  .scene3d-ring-3 {
    inset: 30px;
    border: 1px solid rgba(124,58,237,0.45);
    box-shadow: 0 0 12px rgba(124,58,237,0.3);
  }
  .scene3d-core-inner {
    width: 48px;
    height: 48px;
    box-shadow: 0 0 30px rgba(0,212,255,0.5), 0 0 60px rgba(31,140,255,0.3);
  }
  .scene3d-metrics {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
  }
  .scene3d-metric {
    padding: 12px 10px;
    font-size: 13px;
  }
  .scene3d-metric strong {
    font-size: 1rem;
  }
  .scene3d-chip {
    padding: 6px 12px;
    font-size: 11px;
  }

  .brand-name { font-size: 0.98rem; }
  .brand-subtitle {
    font-size: 0.54rem;
    letter-spacing: 0.1em;
  }
  .hero-features   { grid-template-columns: 1fr; }
  .hero-visual-metrics { grid-template-columns: 1fr; }
  .hero-visual-stack { display: none; }
  .hero-visual-chip-row { justify-content: center; }
  .hero-stats-card { padding: 18px; }
  .hero-feature-card { min-height: 0; }
  .testimonial-card-top { flex-direction: column; }
  .testimonial-rating { align-self: flex-start; }
  .featured-work-card { padding: 20px; }
  .blog-tabs { gap: 8px; }
  .blog-card-body { padding: 20px; }
  .page-shell { padding-top: 64px; }
  .page-content-narrow,
  .blog-post-shell {
    padding: 36px 5%;
  }
  .page-section-white,
  .page-section-muted {
    padding: 48px 5%;
  }
  .blog-post-image-wrap {
    height: 220px;
  }
  .blog-back-link {
    margin-bottom: 18px;
  }
  .not-found-shell {
    min-height: calc(100vh - 64px);
    padding: 32px 5%;
  }
  .review-text {
    display: block;
    -webkit-line-clamp: unset;
    -webkit-box-orient: initial;
    overflow: visible;
  }
  .quote-trust-strip span,
  .plans-urgency-banner {
    width: 100%;
    justify-content: center;
  }
  .blog-inline-cta {
    padding: 20px;
  }
  .blog-inline-cta-buttons {
    flex-direction: column;
    align-items: stretch;
  }
  .blog-inline-cta-buttons .btn {
    width: 100%;
  }
}

@media (min-width: 390px) and (max-width: 430px) {
  .brand-lockup {
    gap: 2px;
  }

  .brand-name {
    font-size: 1rem;
    line-height: 1.08;
  }

  .brand-subtitle {
    font-size: 0.52rem;
    letter-spacing: 0.09em;
    line-height: 1.08;
  }
}

.whatsapp-float {
  position: fixed;
  right: 16px;
  bottom: 18px;
  z-index: 1200;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  min-height: 48px;
  padding: 12px 16px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, #1f8cff 0%, #22c55e 100%);
  color: white;
  font-size: 14px;
  font-weight: 700;
  box-shadow: 0 14px 34px rgba(11, 18, 40, 0.24);
}

.whatsapp-float i {
  font-size: 20px;
}

.whatsapp-float:hover {
  color: white;
  transform: translateY(-2px);
}

@media (max-width: 768px) {
  .whatsapp-float {
    right: 12px;
    left: 12px;
    bottom: 12px;
    justify-content: center;
  }
}
