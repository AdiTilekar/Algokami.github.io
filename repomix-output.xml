  font-size: 13px;
}
.footer-bottom strong { color: white; }
.footer-bottom-links { display: flex; gap: 24px; }
.footer-bottom-links a { color: rgba(255,255,255,0.50); font-size: 13px; }
.footer-bottom-links a:hover { color: var(--color-accent); }

/* ─── INNER PAGE HERO (new 3D version) ─── */
/* Legacy flat hero — kept for any remaining overrides */
.page-hero {
  padding: var(--section-padding);
  padding-top: calc(70px + 80px);
  background:
    radial-gradient(circle at 78% 12%, rgba(0,212,255,0.18), transparent 32%),
    radial-gradient(circle at 5%  88%, rgba(124,58,237,0.20), transparent 38%),
    linear-gradient(145deg, #03080f 0%, #060d20 45%, #0c1a3e 100%);
  text-align: center;
  position: relative;
  overflow: hidden;
}
.page-hero::before {
  content: '';
  position: absolute;
  bottom: 0; left: -10%; right: -10%;
  height: 45%;
  background-image:
    linear-gradient(rgba(31,140,255,0.10) 1px, transparent 1px),
    linear-gradient(90deg, rgba(31,140,255,0.10) 1px, transparent 1px);
  background-size: 52px 52px;
  transform: perspective(600px) rotateX(60deg);
  transform-origin: bottom center;
  animation: gridMove 4s linear infinite;
  pointer-events: none;
  mask-image: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 75%);
  -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 75%);
}
.page-hero h1 {
  font-size: var(--font-size-hero);
  font-weight: 800;
  color: white;
  margin-bottom: 16px;
  position: relative; z-index: 1;
  text-shadow: 0 0 40px var(--glow-blue-soft);
}
.page-hero p {
  font-size: 1.1rem;
  color: rgba(255,255,255,0.72);
  max-width: 600px;
  margin: 0 auto 32px;
  position: relative; z-index: 1;
}
.page-hero .section-label {
  position: relative; z-index: 1;
}

/* ─── PAGE HERO 3D (PageHero component) ─── */
.page-hero-3d {
  position: relative;
  padding: var(--section-padding);
  padding-top: calc(70px + 80px);
  background:
    radial-gradient(circle at 78% 12%, rgba(0,212,255,0.18), transparent 32%),
    radial-gradient(circle at 5%  88%, rgba(124,58,237,0.20), transparent 38%),
    radial-gradient(circle at 50% 50%, rgba(31,140,255,0.08), transparent 55%),
    linear-gradient(145deg, #03080f 0%, #060d20 45%, #0c1a3e 100%);
  text-align: center;
  overflow: hidden;
}
/* Perspective grid floor */
.page-hero-3d::before {
  content: '';
  position: absolute;
  bottom: 0; left: -10%; right: -10%;
  height: 48%;
  background-image:
    linear-gradient(rgba(31,140,255,0.10) 1px, transparent 1px),
    linear-gradient(90deg, rgba(31,140,255,0.10) 1px, transparent 1px);
  background-size: 52px 52px;
  transform: perspective(600px) rotateX(60deg);
  transform-origin: bottom center;
  animation: gridMove 4s linear infinite;
  pointer-events: none;
  mask-image: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 75%);
  -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 75%);
}
/* Decorative glowing orbs */
.ph-orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(60px);
}
.ph-orb-1 {
  width: 350px; height: 350px;
  top: -80px; right: -60px;
  background: radial-gradient(circle, rgba(31,140,255,0.22), transparent 70%);
  animation: glowPulse 6s ease-in-out infinite;
}
.ph-orb-2 {
  width: 280px; height: 280px;
  bottom: -40px; left: -40px;
  background: radial-gradient(circle, rgba(124,58,237,0.20), transparent 70%);
