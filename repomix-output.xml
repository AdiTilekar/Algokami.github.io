  color: white;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,0.12);
  transition: all var(--transition-base);
}
.hero-visual-chip:hover {
  border-color: rgba(0,212,255,0.5);
  box-shadow: 0 0 16px var(--glow-cyan-soft);
}
.hero-visual-chip-alt {
  background: rgba(0,212,255,0.12);
  border-color: rgba(0,212,255,0.25);
}
.hero-visual-card {
  position: relative;
  z-index: 1;
  background: rgba(255,255,255,0.06);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-xl);
  box-shadow: 0 32px 80px rgba(0,0,0,0.40), inset 0 1px 0 rgba(255,255,255,0.08);
  transform-style: preserve-3d;
  animation: glowPulse 6s ease-in-out infinite;
}
.hero-visual-main {
  padding: 28px;
  transform: translateZ(12px);
}
.hero-visual-label {
  display: inline-block;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 14px;
}
.hero-visual-main h3 {
  color: white;
  font-size: 1.45rem;
  line-height: 1.25;
  margin-bottom: 12px;
}
.hero-visual-main p {
  color: rgba(255,255,255,0.74);
  font-size: 0.95rem;
  line-height: 1.7;
}
.hero-visual-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin-top: 22px;
}
.hero-visual-metrics div {
  background: rgba(6, 13, 32, 0.60);
  border: 1px solid rgba(0,212,255,0.15);
  border-radius: var(--radius-lg);
  padding: 14px 12px;
  transition: border-color var(--transition-base);
}
.hero-visual-metrics div:hover {
  border-color: rgba(0,212,255,0.4);
  box-shadow: 0 0 14px var(--glow-cyan-soft);
}
.hero-visual-metrics strong {
  display: block;
  color: var(--color-cyan);
  font-size: 1.15rem;
  margin-bottom: 4px;
}
.hero-visual-metrics span {
  display: block;
  color: rgba(255,255,255,0.60);
  font-size: 12px;
}
.hero-visual-stack {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
}
.hero-visual-mini {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 18px 20px;
  transform: translateZ(8px);
  animation: float3d 7s ease-in-out infinite;
}
.hero-visual-mini:last-child {
  animation-delay: -3.5s;
}
.hero-visual-mini i {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  border-radius: 14px;
  background: rgba(0, 212, 255, 0.12);
  border: 1px solid rgba(0, 212, 255, 0.25);
  color: var(--color-cyan);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  box-shadow: 0 0 16px var(--glow-cyan-soft);
}
.hero-visual-mini strong {
  display: block;
  color: white;
  font-size: 0.98rem;
  margin-bottom: 3px;
}
.hero-visual-mini span {
  display: block;
  color: rgba(255,255,255,0.60);
  font-size: 12px;
}
.hero-stats-card {
  display: flex; align-items: center; gap: 32px;
  background: rgba(0,212,255,0.05);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(0,212,255,0.20);
  border-radius: var(--radius-lg);
  padding: 24px 32px;
  margin-top: 40px;
  animation: borderGlow 4s ease-in-out infinite;
}
.hero-stats-card .stats-info { text-align: center; }
.stats-label { font-size: 12px; color: rgba(255,255,255,0.65); display: block; margin-top: 4px; }
.stats-number { font-size: 1.8rem; font-weight: 800; color: var(--color-accent); line-height: 1; }
.hero-buttons { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; }
.btn-outline-light {
  background: transparent;
  border: 2px solid rgba(255,255,255,0.5);
  color: white;
  padding: 12px 28px;
  border-radius: var(--radius-full);
  font-weight: 600;
  transition: all var(--transition-base);
}
.btn-outline-light:hover {
  background: white;
  color: var(--color-primary);
}
/* Hero Feature Cards */
.hero-features {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}
.hero-feature-card {
  background: rgba(255,255,255,0.10);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: var(--radius-md);
  padding: 28px 24px;
  text-align: center;
  transition: all var(--transition-base);
}
.hero-feature-card:hover {
  background: rgba(255,255,255,0.15);
  transform: translateY(-4px);
}
.hero-feature-card i {
  font-size: 32px;
  color: var(--color-accent);
  margin-bottom: 16px;
  display: block;
}
.hero-feature-card h3 {
  color: white;
  font-size: 16px;
  font-weight: 700;
  margin-bottom: 8px;
}
.hero-feature-card p {
  color: rgba(255,255,255,0.65);
  font-size: 13px;
  margin: 0;
}

/* ─── SCENE3D HERO ─── */
.scene3d-outer {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 16px;
  width: 100%;
}
.scene3d-perspective {
  perspective: 900px;
  perspective-origin: 50% 40%;
  width: 100%;
  height: 340px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.scene3d-stage {
  position: relative;
  width: 260px;
  height: 260px;
  transform-style: preserve-3d;
  transform: rotateX(var(--scene-rx, -4deg)) rotateY(var(--scene-ry, -8deg));
  transition: transform 0.12s ease-out;
  will-change: transform;
}
/* Orbital rings */
.scene3d-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  transform-style: preserve-3d;
}
.scene3d-ring-1 {
  border: 2px solid rgba(31,140,255,0.55);
  box-shadow: 0 0 20px var(--glow-blue-soft), inset 0 0 20px rgba(31,140,255,0.05);
  animation: ringRotate 8s linear infinite;
}
.scene3d-ring-2 {
  inset: -40px;
  border: 1.5px solid rgba(0,212,255,0.40);
  box-shadow: 0 0 24px var(--glow-cyan-soft);
  animation: ringRotateReverse 12s linear infinite;
}
.scene3d-ring-3 {
  inset: 40px;
  border: 1px solid rgba(124,58,237,0.45);
  box-shadow: 0 0 16px var(--glow-purple);
  animation: ringRotate 6s linear infinite;
  animation-delay: -3s;
}
/* Satellite orb tracks */
.scene3d-orb-track-1 {
  position: absolute;
  inset: 0;
  animation: orbit 8s linear infinite;
  transform-style: preserve-3d;
}
.scene3d-orb-track-2 {
  position: absolute;
  inset: -40px;
  animation: orbitReverse 12s linear infinite;
  animation-delay: -4s;
  transform-style: preserve-3d;
}
.scene3d-orb-track-3 {
  position: absolute;
  inset: 40px;
  animation: orbit 6s linear infinite;
  animation-delay: -2s;
  transform-style: preserve-3d;
}
.scene3d-orb {
  position: absolute;
  top: 50%;
  left: 0;
  width: 12px; height: 12px;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}
.scene3d-orb-blue  { background: var(--color-accent); box-shadow: 0 0 12px var(--glow-blue); }
.scene3d-orb-cyan  { background: var(--color-cyan); box-shadow: 0 0 12px var(--glow-cyan); }
.scene3d-orb-purple{ background: var(--color-purple-light); box-shadow: 0 0 12px var(--glow-purple); }
/* Glowing core */
.scene3d-core {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.scene3d-core-inner {
  width: 64px; height: 64px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0,212,255,0.6), rgba(31,140,255,0.3) 50%, transparent 75%);
  box-shadow: 0 0 40px var(--glow-cyan), 0 0 80px var(--glow-blue-soft);
  animation: glowPulseCyan 3s ease-in-out infinite;
}
/* Scan line */
.scene3d-scan {
  position: absolute;
  left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(0,212,255,0.8), transparent);
  top: 0;
  animation: scanLine 4s linear infinite;
  box-shadow: 0 0 8px var(--glow-cyan);
}
/* Chip row below scene */
.scene3d-chip-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}
.scene3d-chip {
  display: inline-flex;
  align-items: center;
  padding: 8px 14px;
  border-radius: var(--radius-full);
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
  color: white;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  backdrop-filter: blur(10px);
}
.scene3d-chip-cyan {
  background: rgba(0,212,255,0.10);
  border-color: rgba(0,212,255,0.25);
  color: var(--color-cyan);
}
/* Metrics row */
.scene3d-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}
.scene3d-metric {
  background: rgba(6,13,32,0.70);
  border: 1px solid rgba(0,212,255,0.15);
  border-radius: var(--radius-lg);
  padding: 14px 12px;
  text-align: center;
  transition: border-color var(--transition-base), box-shadow var(--transition-base);
}
.scene3d-metric:hover {
  border-color: rgba(0,212,255,0.45);
  box-shadow: 0 0 16px var(--glow-cyan-soft);
}
.scene3d-metric strong {
  display: block;
  color: var(--color-cyan);
  font-size: 1.1rem;
  margin-bottom: 4px;
}
.scene3d-metric span {
  display: block;
  color: rgba(255,255,255,0.55);
  font-size: 11px;
}

/* ─── SERVICES ─── */
.services-section {
  padding: var(--section-padding);
  background:
    radial-gradient(circle at 80% 20%, rgba(31,140,255,0.06), transparent 40%),
    radial-gradient(circle at 10% 80%, rgba(0,212,255,0.04), transparent 40%),
    linear-gradient(180deg, #f0f4ff 0%, #eef2ff 100%);
  position: relative;
  overflow: hidden;
}
/* Subtle hex-dot grid overlay */
.services-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle, rgba(31,140,255,0.08) 1px, transparent 1px);
  background-size: 32px 32px;
  pointer-events: none;
}
.services-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px; position: relative; z-index: 1; }
/* TiltCard wrapper inherits full height */
.tilt-card-wrapper { height: 100%; display: block; }
.service-card {
  background: linear-gradient(165deg, #ffffff 0%, #f5f8ff 100%);
  border-radius: var(--radius-lg);
  padding: var(--card-padding);
  box-shadow: 0 18px 40px rgba(12, 28, 66, 0.08);
  transition: box-shadow 0.3s ease;
  border: 1px solid rgba(24, 47, 104, 0.08);
  height: 100%;
  transform: perspective(var(--perspective-card)) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
  transition: transform 0.15s ease-out, box-shadow 0.3s ease;
  will-change: transform;
  position: relative;
  overflow: hidden;
}
/* Shimmer surface effect */
.service-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    105deg,
    transparent 40%,
    rgba(255,255,255,0.4) 50%,
    transparent 60%
  );
  background-size: 200% 100%;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
  border-radius: inherit;
}
.service-card:hover::before { opacity: 1; animation: shimmer 0.8s ease forwards; }
.service-card:hover {
  box-shadow:
    0 28px 60px rgba(12, 28, 66, 0.16),
    0 0 0 1px rgba(31,140,255,0.20),
    0 0 40px rgba(31,140,255,0.06);
}
.service-card-link {
  display: block;
  height: 100%;
  color: inherit;
  cursor: pointer;
  pointer-events: auto;
}
.service-card-link:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 4px;
  border-radius: var(--radius-md);
}
.service-card-top {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  margin-bottom: 16px;
}
.service-icon {
  width: 56px; height: 56px; border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
  font-size: 22px; margin-bottom: 20px;
  flex-shrink: 0;
}
.service-card-top .service-icon { margin-bottom: 0; }
.service-card-copy { min-width: 0; }
.icon-blue   { background: rgba(26,31,94,0.08);  color: var(--color-accent); }
.icon-orange { background: rgba(0,212,255,0.10); color: var(--color-cyan); }
.service-card h3 {
  font-size: 1.15rem; font-weight: 700;
  font-family: var(--font-display);
  color: var(--color-primary); margin-bottom: 12px;
}
.service-card p {
  font-size: 0.9rem;
  color: var(--text-muted);
  line-height: 1.7;
  margin-bottom: 20px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.service-link,
.service-link-btn {
  font-size: 0.875rem; font-weight: 600; color: var(--color-accent);
  display: inline-flex; align-items: center; gap: 6px;
  transition: gap var(--transition-base);
}
.service-link-btn {
  margin-top: 2px;
}
.service-card:hover .service-link-btn,
.service-card-link:focus-visible .service-link-btn {
  gap: 12px;
}

/* ─── FEATURED WORK ─── */
.featured-work-section { padding: var(--section-padding); background: white; }
.featured-work-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  gap: 28px;
}
.featured-work-card {
  background: white;
  border-radius: var(--radius-lg);
  padding: var(--card-padding);
  box-shadow: var(--shadow-md);
  border: 1px solid rgba(0,0,0,0.05);
}
.featured-work-sector {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 12px;
}
.featured-work-card h3 {
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 10px;
}
.featured-work-card p {
  font-size: 0.9rem;
  color: var(--text-muted);
  line-height: 1.7;
  margin-bottom: 16px;
}
.featured-work-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--color-accent);
}
.featured-work-link:hover { gap: 12px; }

/* ─── PROCESS ─── */
.process-section {
  padding: var(--section-padding);
  background:
    radial-gradient(circle at 90% 10%, rgba(0,212,255,0.06), transparent 40%),
    white;
  position: relative;
  overflow: hidden;
}
/* Subtle left-edge lane line */
.process-section::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 3px;
  background: linear-gradient(to bottom, transparent, var(--color-cyan), var(--color-accent), transparent);
  opacity: 0.3;
}
.process-inner {
  display: grid; grid-template-columns: 2fr 3fr;
  gap: 80px; align-items: center;
}
.process-step {
  display: flex; gap: 20px;
  padding-bottom: 36px; position: relative;
}
.process-step:not(.last)::before {
  content: ''; position: absolute;
  left: 19px; top: 44px; bottom: 0;
  width: 2px;
  background: linear-gradient(to bottom, var(--color-accent), rgba(0,212,255,0.3));
  box-shadow: 0 0 8px var(--glow-blue-soft);
}
.step-badge {
  flex-shrink: 0; width: 40px; height: 40px;
  background: linear-gradient(135deg, var(--color-accent-dark), var(--color-cyan));
  color: white;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 15px; position: relative; z-index: 1;
  box-shadow: 0 0 20px var(--glow-blue-soft);
  animation: glowPulse 3s ease-in-out infinite;
}
.step-content h3 {
  font-size: 1rem; font-weight: 700;
  color: var(--color-primary-mid); margin-bottom: 6px;
}
.step-content p { font-size: 0.875rem; color: var(--text-muted); line-height: 1.65; }

/* ─── INDUSTRIES ─── */
.industries-section { padding: var(--section-padding); background: var(--bg-light); }
.industries-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 24px; }
.industry-item {
  display: flex; flex-direction: column;
  align-items: center; gap: 12px; cursor: default;
}
.industry-icon {
  width: 72px; height: 72px; background: white; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 26px; color: var(--color-primary);
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-base);
}
.industry-item:hover .industry-icon {
  background: var(--color-accent); color: white;
  transform: scale(1.1);
  box-shadow: 0 8px 24px rgba(245,166,35,0.30);
}
.industry-item span {
  font-size: 12px; font-weight: 600;
  color: var(--text-dark); text-align: center;
}

/* ─── TESTIMONIALS ─── */
.testimonials-section {
  padding: var(--section-padding);
  background:
    radial-gradient(circle at 15% 50%, rgba(124,58,237,0.06), transparent 40%),
    radial-gradient(circle at 85% 20%, rgba(31,140,255,0.07), transparent 40%),
    white;
}
.testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
.testimonial-card {
  background: white;
  border-radius: var(--radius-lg);
  padding: var(--card-padding);
  box-shadow: 0 18px 40px rgba(12,28,66,0.08);
  border: 1px solid rgba(24,47,104,0.07);
  transform: perspective(var(--perspective-card)) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));
  transition: transform 0.15s ease-out, box-shadow 0.3s ease;
  will-change: transform;
  position: relative;
  overflow: hidden;
}
.testimonial-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--color-accent), var(--color-cyan));
  opacity: 0;
  transition: opacity var(--transition-base);
}
.testimonial-card:hover::after { opacity: 1; }
.testimonial-card:hover {
  box-shadow: 0 28px 60px rgba(12,28,66,0.16), 0 0 0 1px rgba(31,140,255,0.16);
}
.testimonial-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 14px;
}
.testimonial-rating {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-radius: var(--radius-full);
  background: var(--bg-light);
  color: var(--color-primary);
  flex-shrink: 0;
}
.rating-score {
  font-size: 12px;
  font-weight: 700;
}
.quote-mark {
  font-size: 52px; line-height: 0.6;
  color: var(--color-accent);
  font-family: Georgia, serif; margin-bottom: 10px;
}
.review-text {
  font-size: 0.9rem;
  color: var(--text-muted);
  line-height: 1.8;
  margin-bottom: 24px;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.reviewer-row { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
.reviewer-avatar { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; }
.reviewer-avatar-initials {
  width: 48px; height: 48px; border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  color: white;
  font-size: 16px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.reviewer-name { display: block; font-size: 0.95rem; color: var(--text-dark); font-weight: 600; }
.reviewer-role { font-size: 0.8rem; color: var(--text-muted); }
.stars { color: var(--color-accent); font-size: 16px; letter-spacing: 2px; }

/* ─── PACKAGES 3D ─── */
.service-packages-section {
  padding: var(--section-padding);
  background:
    radial-gradient(circle at 5% 50%, rgba(31,140,255,0.08), transparent 40%),
    linear-gradient(180deg, #f0f5ff 0%, #ffffff 100%);
  position: relative;
  overflow: hidden;
}
/* 3D grid floor on packages */
.service-packages-section::before {
  content: '';
  position: absolute;
  bottom: 0; left: -10%; right: -10%;
  height: 40%;
  background-image:
    linear-gradient(rgba(31,140,255,0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(31,140,255,0.08) 1px, transparent 1px);
  background-size: 48px 48px;
  transform: perspective(500px) rotateX(55deg);
  transform-origin: bottom center;
  pointer-events: none;
  mask-image: linear-gradient(to top, rgba(0,0,0,0.3) 0%, transparent 70%);
  -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,0.3) 0%, transparent 70%);
}
.service-package-card {
  position: relative;
  height: 100%;
  min-width: 0;
  border-radius: var(--radius-xl);
  padding: 28px;
  border: 1px solid rgba(19, 44, 102, 0.1);
  background: #ffffff;
  box-shadow: 0 20px 50px rgba(12,28,66,0.10);
  transform: perspective(var(--perspective-card)) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));
  transition: transform 0.15s ease-out, box-shadow 0.3s ease;
  will-change: transform;
}
.service-package-card.featured {
  border-color: transparent;
  box-shadow: 0 24px 64px rgba(23, 87, 185, 0.22);
  background: linear-gradient(#fff, #fff) padding-box,
              linear-gradient(135deg, var(--color-accent), var(--color-cyan), var(--color-purple), var(--color-accent)) border-box;
  border: 2px solid transparent;
  animation: holographic 4s ease infinite;
  background-size: 300% 300%;
}

/* ─── LOGOS / TECH ─── */
.logos-section { padding: 60px 5%; background: var(--bg-light); }
.tech-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 24px;
}
.tech-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  padding: 24px 32px;
  background: white;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-base);
}
.tech-item:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
}
.tech-item i {
  font-size: 40px;
  color: var(--color-primary);
}
.tech-item span {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-dark);
}

/* ─── CONTACT ─── */
.contact-section { padding: var(--section-padding); background: var(--bg-light); }
.contact-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
.contact-items { margin-top: 36px; display: flex; flex-direction: column; gap: 20px; }
.contact-item { display: flex; align-items: flex-start; gap: 16px; }
.contact-icon {
  width: 44px; height: 44px;
  background: var(--color-primary); color: white;
  border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.contact-item strong { display: block; font-size: 0.9rem; color: var(--text-dark); }
.contact-item span   { font-size: 0.875rem; color: var(--text-muted); }
.contact-phone-list {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.contact-phone-list a {
  color: var(--text-medium);
  font-weight: 600;
}
.contact-form-wrapper {
  background: white; border-radius: var(--radius-xl);
  padding: 40px; box-shadow: var(--shadow-md);
}
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.form-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 20px; }
.form-group label { font-size: 13px; font-weight: 600; color: var(--text-dark); }
.form-group input,
.form-group textarea,
.form-group select {
  width: 100%;
  padding: 13px 16px;
  border: 1.5px solid #e5e7eb;
  border-radius: var(--radius-md);
  font-family: var(--font-family);
  font-size: 14px; color: var(--text-dark);
  transition: border-color var(--transition-base);
  outline: none; resize: none; background: white;
}
.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 3px rgba(245,166,35,0.12);
}
.form-message {
  padding: 12px 16px; border-radius: var(--radius-md);
  font-size: 14px; margin-top: 12px; font-weight: 500;
}
.form-message.success { background: #d1fae5; color: #065f46; }
.form-message.error   { background: #fee2e2; color: #991b1b; }
.contact-submit-btn {
  width: 100%;
  justify-content: center;
}

.quote-trust-strip {
  margin: 18px auto 0;
  max-width: 860px;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
}

.quote-trust-strip span {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-radius: var(--radius-full);
  border: 1px solid rgba(255, 255, 255, 0.22);
  background: rgba(255, 255, 255, 0.11);
  color: rgba(255, 255, 255, 0.92);
  font-size: 12px;
  font-weight: 700;
}

.quote-trust-strip i {
  color: var(--color-accent-light);
}

/* ─── BLOG ─── */
.blog-section { padding: var(--section-padding); background: white; }
.blog-tabs { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-bottom: 40px; }
.blog-tab {
  padding: 8px 20px; border-radius: var(--radius-full);
  font-size: 14px; font-weight: 600;
  border: 2px solid #e5e7eb;
  background: transparent; color: var(--text-muted);
  cursor: pointer; transition: all var(--transition-base);
}
.blog-tab.active,
.blog-tab:hover {
  border-color: var(--color-accent);
  background: var(--color-accent); color: white;
}
.blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
.blog-card {
  display: block;
  background: white; border-radius: var(--radius-lg);
  overflow: hidden; box-shadow: var(--shadow-md);
  border: 1px solid rgba(0,0,0,0.05);
  transition: all var(--transition-base);
  text-decoration: none;
}
.blog-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-hover); }
.blog-card-icon {
  height: 140px;
  background: linear-gradient(135deg, var(--color-primary), #2a3080);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  position: relative;
}
.blog-card-icon i {
  font-size: 48px;
  color: var(--color-accent);
}
.blog-category {
  background: var(--color-accent); color: white;
  font-size: 11px; font-weight: 700; text-transform: uppercase;
  padding: 4px 12px; border-radius: var(--radius-full);
}
.blog-card-body { padding: 24px; }
.blog-card-meta {
  font-size: 12px; color: var(--text-muted); margin-bottom: 10px;
  display: flex; gap: 12px; align-items: center;
}
.blog-card h3 {
  font-size: 1.05rem; font-weight: 700;
  color: var(--color-primary); margin-bottom: 10px;
  line-height: 1.4;
}
.blog-card p { font-size: 0.875rem; color: var(--text-muted); line-height: 1.65; margin-bottom: 16px; }
.blog-read-more {
  font-size: 0.875rem; font-weight: 600; color: var(--color-accent);
  display: inline-flex; align-items: center; gap: 6px;
  transition: gap var(--transition-base);
}
.blog-card:hover .blog-read-more { gap: 12px; }

/* ─── CTA BANNER ─── */
.cta-banner-section {
  padding: var(--section-padding);
  background:
    radial-gradient(circle at 15% 25%, rgba(0,212,255,0.22), transparent 38%),
    radial-gradient(circle at 85% 75%, rgba(124,58,237,0.20), transparent 35%),
    radial-gradient(circle at 50% 50%, rgba(31,140,255,0.12), transparent 55%),
    linear-gradient(140deg, #03080f 0%, #060d20 50%, #0c1a3e 100%);
  text-align: center;
  position: relative;
  overflow: hidden;
}
/* Animated perspective grid floor */
.cta-banner-section::before {
  content: '';
  position: absolute;
  bottom: 0; left: -10%; right: -10%;
  height: 50%;
  background-image:
    linear-gradient(rgba(0,212,255,0.10) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,212,255,0.10) 1px, transparent 1px);
  background-size: 50px 50px;
  transform: perspective(500px) rotateX(60deg);
  transform-origin: bottom center;
  pointer-events: none;
  mask-image: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 75%);
  -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 75%);
}
/* Glowing orbs */
.cta-banner-section::after {
  content: '';
  position: absolute;
  width: 400px; height: 400px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0,212,255,0.15), transparent 65%);
  top: -100px; right: -80px;
  pointer-events: none;
  animation: glowPulseCyan 5s ease-in-out infinite;
}
.cta-banner-section h2 {
  font-size: var(--font-size-section);
  font-weight: 800;
  font-family: var(--font-display);
  color: white;
  margin-bottom: 16px;
  text-shadow: 0 0 40px var(--glow-blue-soft);
  position: relative; z-index: 1;
}
.cta-banner-section p {
  font-size: 1.1rem;
  color: rgba(255,255,255,0.72);
  max-width: 600px;
  margin: 0 auto 40px;
  position: relative; z-index: 1;
}
.cta-buttons { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; position: relative; z-index: 1; }

.process-cta-btn {
  margin-top: 32px;
}

.section-header-compact {
  margin-bottom: 32px;
}

.plans-proof-strip {
  margin-top: 26px;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
}

.plans-proof-strip span {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(31, 140, 255, 0.2);
  color: var(--color-primary);
  font-size: 12px;
  font-weight: 700;
}

.plans-proof-strip i {
  color: var(--color-accent);
}

.plans-urgency-banner {
  margin: 18px auto 0;
  max-width: 680px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 14px;
  border-radius: var(--radius-full);
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: rgba(245, 166, 35, 0.18);
  color: rgba(255, 255, 255, 0.95);
  font-size: 12px;
  font-weight: 700;
}

.plans-urgency-banner i {
  color: #ffd07a;
}

.blog-inline-cta {
  margin-top: 36px;
  padding: 24px;
  border-radius: var(--radius-xl);
  border: 1px solid rgba(31, 140, 255, 0.24);
  background: linear-gradient(165deg, #f8fbff 0%, #eef5ff 100%);
}

.blog-inline-cta h3 {
  font-size: 1.2rem;
  color: var(--color-primary);
  margin-bottom: 8px;
}

.blog-inline-cta p {
  color: var(--text-muted);
  margin-bottom: 14px;
}

.blog-inline-cta-buttons {
  justify-content: flex-start;
}

/* ─── FOOTER ─── */
.footer {
  background:
    radial-gradient(circle at 80% 30%, rgba(31,140,255,0.08), transparent 40%),
    radial-gradient(circle at 10% 70%, rgba(0,212,255,0.06), transparent 35%),
    var(--color-primary-dark);
  padding: 70px 5% 0;
  color: rgba(255,255,255,0.65);
  position: relative;
  overflow: hidden;
}
/* CSS star-field */
.footer::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(circle 1px at 10% 20%, rgba(255,255,255,0.4) 0%, transparent 0%),
    radial-gradient(circle 1px at 25% 60%, rgba(0,212,255,0.35) 0%, transparent 0%),
    radial-gradient(circle 1px at 40% 15%, rgba(255,255,255,0.3) 0%, transparent 0%),
    radial-gradient(circle 1px at 55% 75%, rgba(31,140,255,0.4) 0%, transparent 0%),
    radial-gradient(circle 1px at 70% 35%, rgba(255,255,255,0.35) 0%, transparent 0%),
    radial-gradient(circle 1px at 85% 55%, rgba(0,212,255,0.30) 0%, transparent 0%),
    radial-gradient(circle 1px at 92% 15%, rgba(255,255,255,0.4) 0%, transparent 0%),
    radial-gradient(circle 1px at 18% 85%, rgba(124,58,237,0.30) 0%, transparent 0%),
    radial-gradient(circle 1px at 62% 90%, rgba(255,255,255,0.25) 0%, transparent 0%),
    radial-gradient(circle 1px at 77% 80%, rgba(31,140,255,0.30) 0%, transparent 0%);
  pointer-events: none;
