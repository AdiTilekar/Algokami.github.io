  /* Reduce glow effects on very small screens for performance */
  .scene3d-ring-1,
  .scene3d-ring-2,
  .scene3d-ring-3 {
    box-shadow: 0 0 8px rgba(31,140,255,0.3) !important;
  }

  .scene3d-core-inner {
    box-shadow: 0 0 20px rgba(0,212,255,0.4), 0 0 40px rgba(31,140,255,0.2) !important;
  }

  .scene3d-orb {
    width: 10px;
    height: 10px;
  }
}
