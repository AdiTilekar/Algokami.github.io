/* ═══════════════════════════════════
   CSS CUSTOM PROPERTIES (Design Tokens)
═══════════════════════════════════ */
:root {
  /* Brand Colors */
  --color-primary:        #060d20;
  --color-primary-dark:   #03080f;
  --color-primary-mid:    #0c1a3e;
  --color-primary-light:  #132a6e;
  --color-accent:         #1f8cff;
  --color-accent-dark:    #0d72e2;
  --color-accent-light:   #6eb6ff;

  /* 3D / Neon Accent System */
  --color-cyan:           #00d4ff;
  --color-cyan-dark:      #00a8cc;
  --color-purple:         #7c3aed;
  --color-purple-light:   #a855f7;
  --color-orange:         #f5a623;
  --color-orange-dark:    #e09415;

  /* Glow Variables */
  --glow-blue:            rgba(31, 140, 255, 0.50);
  --glow-blue-soft:       rgba(31, 140, 255, 0.25);
  --glow-cyan:            rgba(0, 212, 255, 0.40);
  --glow-cyan-soft:       rgba(0, 212, 255, 0.18);
  --glow-purple:          rgba(124, 58, 237, 0.40);
  --glow-orange:          rgba(245, 166, 35, 0.45);

  /* 3D / Perspective Variables */
  --perspective-base:     1200px;
  --perspective-card:     800px;
  --tilt-max:             12deg;
  --depth-1:              translateZ(8px);
  --depth-2:              translateZ(16px);
  --depth-3:              translateZ(28px);

  /* Backgrounds */
  --bg-white:             #ffffff;
  --bg-light:             #f3f6ff;
  --bg-dark:              #060c1f;

  /* Text */
  --text-dark:            #131a30;
  --text-medium:          #2d385b;
  --text-muted:           #5f6a8e;
  --text-light:           rgba(255, 255, 255, 0.75);
  --text-white:           #ffffff;

  /* Typography */
  --font-family:          var(--font-body), sans-serif;
  --font-display:         var(--font-display), sans-serif;
  --font-size-hero:       clamp(2rem, 4vw, 3.2rem);
  --font-size-section:    clamp(1.8rem, 3vw, 2.5rem);

  /* Spacing */
  --section-padding:      100px 5%;
  --section-padding-sm:   60px 5%;
  --card-padding:         32px;
  --container-max:        1200px;

  /* Borders & Radius */
  --radius-sm:            8px;
  --radius-md:            12px;
  --radius-lg:            16px;
  --radius-xl:            24px;
  --radius-full:          9999px;

  /* Shadows */
  --shadow-sm:            0 10px 20px rgba(7, 18, 46, 0.08);
  --shadow-md:            0 18px 40px rgba(7, 18, 46, 0.10);
  --shadow-lg:            0 28px 70px rgba(7, 18, 46, 0.14);
  --shadow-hover:         0 26px 56px rgba(20, 55, 118, 0.22);
  --shadow-3d:            0 32px 80px rgba(6, 13, 32, 0.60), 0 8px 24px rgba(31, 140, 255, 0.12);
  --shadow-glow-blue:     0 0 24px var(--glow-blue), 0 8px 32px rgba(6, 13, 32, 0.5);
  --shadow-glow-cyan:     0 0 24px var(--glow-cyan), 0 8px 32px rgba(6, 13, 32, 0.5);
  --shadow-glow-orange:   0 0 20px var(--glow-orange), 0 8px 24px rgba(6, 13, 32, 0.4);

  /* Transitions */
  --transition-fast:      0.2s ease;
  --transition-base:      0.3s ease;
  --transition-slow:      0.5s ease;

  /* Z-index Scale */
  --z-dropdown:           100;
  --z-sticky:             500;
  --z-navbar:             1000;
  --z-banner:             999;
}

/* ═══════════════════════════════════
   RESET & BASE
═══════════════════════════════════ */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
  /* Prevent white flash on overscroll bounce */
  background-color: var(--color-primary-dark);
  overscroll-behavior-y: none;
}

body {
  font-family: var(--font-family);
  color: var(--text-dark);
  background-color: var(--bg-white);
  overflow-x: hidden;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

img { max-width: 100%; height: auto; display: block; }
a   { text-decoration: none; color: inherit; transition: color var(--transition-base); }
ul  { list-style: none; }
button { cursor: pointer; border: none; outline: none; font-family: var(--font-family); }

/* ═══════════════════════════════════
   UTILITY CLASSES
═══════════════════════════════════ */
.container {
  max-width: var(--container-max);
