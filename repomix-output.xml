/* ═══════════════════════════════════
   MOBILE OPTIMIZATIONS
═══════════════════════════════════ */
@media (max-width: 768px) {
  /* Reduce animation intensity on mobile for better performance */
  .scene3d-ring-1,
  .scene3d-ring-2,
  .scene3d-ring-3 {
    animation-duration: 12s !important;
