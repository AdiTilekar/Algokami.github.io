}

/* ═══════════════════════════════════
   KEYFRAMES — 2D
═══════════════════════════════════ */
@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50%       { transform: translateY(-16px); }
}
@keyframes slideUp {
  from { transform: translateY(100%); opacity: 0; }
  to   { transform: translateY(0);    opacity: 1; }
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes blink {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0; }
}

/* ═══════════════════════════════════
   KEYFRAMES — 3D & NEON
═══════════════════════════════════ */
@keyframes float3d {
  0%, 100% { transform: translateY(0px) rotateX(0deg) rotateZ(0deg); }
  33%       { transform: translateY(-12px) rotateX(3deg) rotateZ(1deg); }
  66%       { transform: translateY(-6px) rotateX(-2deg) rotateZ(-1deg); }
}
@keyframes glowPulse {
  0%, 100% { box-shadow: 0 0 16px var(--glow-blue-soft), 0 0 40px transparent; }
  50%       { box-shadow: 0 0 32px var(--glow-blue), 0 0 64px var(--glow-cyan-soft); }
}
@keyframes glowPulseCyan {
  0%, 100% { box-shadow: 0 0 16px var(--glow-cyan-soft), 0 0 40px transparent; }
  50%       { box-shadow: 0 0 40px var(--glow-cyan), 0 0 80px var(--glow-blue-soft); }
}
@keyframes orbit {
  from { transform: rotateZ(0deg) translateX(80px) rotateZ(0deg); }
  to   { transform: rotateZ(360deg) translateX(80px) rotateZ(-360deg); }
}
@keyframes orbitReverse {
  from { transform: rotateZ(0deg) translateX(110px) rotateZ(0deg); }
  to   { transform: rotateZ(-360deg) translateX(110px) rotateZ(360deg); }
}
@keyframes ringRotate {
  from { transform: rotateX(70deg) rotateZ(0deg); }
  to   { transform: rotateX(70deg) rotateZ(360deg); }
}
@keyframes ringRotateReverse {
  from { transform: rotateX(65deg) rotateZ(0deg); }
  to   { transform: rotateX(65deg) rotateZ(-360deg); }
}
@keyframes holographic {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
@keyframes scanLine {
  0%   { transform: translateY(-100%); opacity: 0; }
  10%  { opacity: 1; }
  90%  { opacity: 1; }
  100% { transform: translateY(100vh); opacity: 0; }
}
@keyframes gridMove {
  from { background-position: 0 0; }
  to   { background-position: 0 60px; }
}
@keyframes shimmer {
  from { background-position: -200% center; }
  to   { background-position: 200% center; }
}
@keyframes particleDrift {
  0%   { transform: translate(0, 0) scale(1); opacity: 0.6; }
  50%  { transform: translate(20px, -30px) scale(1.2); opacity: 1; }
  100% { transform: translate(-10px, -60px) scale(0.8); opacity: 0; }
}
@keyframes borderGlow {
  0%, 100% { border-color: rgba(31, 140, 255, 0.3); }
  50%       { border-color: rgba(0, 212, 255, 0.8); }
}

/* ═══════════════════════════════════
   3D UTILITY CLASSES
═══════════════════════════════════ */
.perspective-wrap {
  perspective: var(--perspective-base);
  perspective-origin: center center;
}

.card-3d {
  transform-style: preserve-3d;
  transition: transform 0.4s ease, box-shadow 0.4s ease;
}

.tilt-card {
  transform-style: preserve-3d;
  transform: perspective(var(--perspective-card)) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
  transition: transform 0.15s ease-out, box-shadow 0.3s ease;
  will-change: transform;
}

.tilt-card:hover {
  box-shadow: var(--shadow-3d);
}

.glow-blue {
  box-shadow: var(--shadow-glow-blue);
}

.glow-cyan {
  box-shadow: var(--shadow-glow-cyan);
}

.neon-text {
  text-shadow: 0 0 20px var(--glow-blue), 0 0 40px var(--glow-cyan-soft);
}

.holographic-border {
  border: 1px solid transparent;
  background-clip: padding-box;
  position: relative;
}
.holographic-border::before {
  content: '';
  position: absolute;
  inset: -1px;
  border-radius: inherit;
  background: linear-gradient(135deg, var(--color-accent), var(--color-cyan), var(--color-purple), var(--color-accent));
